<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.PaquetesController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Gestión de Paquetes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Administra los paquetes disponibles en el sistema." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
        <HBox spacing="10">
            <Button fx:id="btnEditar" text="Editar" styleClass="boton-azul-claro" disable="true" onAction="#editarPaquete"/>
            <Button fx:id="btnEliminar" text="Eliminar" styleClass="boton-rojo" disable="true" onAction="#eliminarPaquete"/>
            <Button text="+ Nuevo Paquete" styleClass="boton-azul" onAction="#nuevoPaquete"/>
        </HBox>
    </HBox>

    <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="15">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre o descripción..." HBox.hgrow="ALWAYS" styleClass="text-field-moderno"/>
            <Button text="Buscar" styleClass="boton-azul-claro"/>
        </HBox>

        <fx:define>
            <TableView fx:id="tablaPaquetes">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="80" />
                    <TableColumn fx:id="colNombre" text="Nombre del Paquete" prefWidth="250" />
                    <TableColumn fx:id="colPrecio" text="Costo Base" prefWidth="120" />
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300" />
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="120" style="-fx-alignment: CENTER;" />
                </columns>
            </TableView>
        </fx:define>
        
        <Pagination fx:id="paginacion" VBox.vgrow="ALWAYS" maxPageIndicatorCount="7" />
    </VBox>
</VBox>
