<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import org.controlsfx.control.SearchableComboBox?>

<!-- Padding reducido a 15px top/bottom para caber en 720px -->
<VBox spacing="12" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.CotizacionController">
    <padding>
        <Insets top="18" right="40" bottom="18" left="40"/>
    </padding>

    <!-- CABECERA -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Nueva Cotización" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Llene los datos. Los cambios se calculan automáticamente." style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </VBox>
        <VBox alignment="CENTER_RIGHT">
            <Label text="TOTAL ESTIMADO" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
            <Label fx:id="lblTotalEstimado" text=" $0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a82b8;"/>
        </VBox>
    </HBox>

    <!-- CUERPO PRINCIPAL -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- ── COLUMNA IZQUIERDA ── -->
        <VBox spacing="10" prefWidth="320" HBox.hgrow="NEVER">

            <!-- ASIGNAR CLIENTE -->
            <VBox styleClass="tarjeta-blanca" spacing="8">
                <Label text="ASIGNAR CLIENTE" styleClass="titulo-seccion">
                    <graphic>
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#2c3e50" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Label>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <SearchableComboBox fx:id="comboClientes"
                                        promptText="Buscar por nombre o teléfono..."
                                        styleClass="combo-box-base"
                                        HBox.hgrow="ALWAYS" />
                    <Button text="+" styleClass="boton-cuadrado-icono" onAction="#abrirModalNuevoCliente"/>
                </HBox>
            </VBox>

            <!-- AGENDA DEL EVENTO -->
            <VBox styleClass="tarjeta-blanca" spacing="8">
                <Label text="AGENDA DEL EVENTO" styleClass="titulo-seccion">
                    <graphic>
                        <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" fill="#2c3e50" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Label>
                <!-- Fecha y Turno en la misma fila -->
                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="FECHA" styleClass="label-pequeno"/>
                        <DatePicker fx:id="datePickerFecha" maxWidth="Infinity" styleClass="text-field-moderno"/>
                    </VBox>
                    <VBox spacing="4" minWidth="130" prefWidth="130">
                        <Label text="TURNO" styleClass="label-pequeno"/>
                        <ComboBox fx:id="comboTurnos" promptText="Turno..." maxWidth="Infinity" styleClass="text-field-moderno"/>
                    </VBox>
                </HBox>
                <Label fx:id="lblErrorTurnos" text="No hay turnos disponibles para esta fecha." style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-font-weight: bold;" visible="false" managed="false">
                    <graphic>
                        <SVGPath content="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" fill="#e74c3c" scaleX="0.7" scaleY="0.7"/>
                    </graphic>
                </Label>
            </VBox>

            <!-- DETALLES DEL FESTEJADO -->
            <VBox styleClass="tarjeta-blanca" spacing="8">
                <Label text="DETALLES DEL FESTEJADO" styleClass="titulo-seccion">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="#2c3e50" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Label>
                <!-- Nombre y Temática en la misma fila -->
                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="NOMBRE DEL FESTEJADO" styleClass="label-pequeno"/>
                        <TextField fx:id="txtNombreFestejado"
                                   promptText="Ej. María F..."
                                   styleClass="text-field-moderno"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="TEMÁTICA" styleClass="label-pequeno"/>
                        <TextField fx:id="txtTematica"
                                   promptText="Ej. Frozen..."
                                   styleClass="text-field-moderno"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- NOTAS DEL EVENTO -->
            <VBox styleClass="tarjeta-blanca" spacing="8">
                <Label text="NOTAS DEL EVENTO" styleClass="titulo-seccion">
                    <graphic>
                        <SVGPath content="M3 18h12v-2H3v2zm0-5h12v-2H3v2zm0-7v2h12V6H3zm14 9.67V7h-2v8.17l1 .83z" fill="#2c3e50" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Label>
                <TextArea fx:id="textAreaNotas"
                          promptText="Agrega notas logísticas o indicaciones especiales..."
                          wrapText="true"
                          prefHeight="90"
                          styleClass="text-area-notas"/>
            </VBox>
        </VBox>

        <!-- ── COLUMNA DERECHA ── -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">

            <!-- PAQUETE BASE -->
            <VBox styleClass="tarjeta-blanca" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="PAQUETE BASE" styleClass="titulo-seccion">
                        <graphic>
                            <SVGPath content="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" fill="#2c3e50" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <SearchableComboBox fx:id="comboPaquetes" promptText="Seleccione un paquete..." styleClass="combo-box-base" prefWidth="230"/>
                </HBox>

                <VBox styleClass="tarjeta-paquete-seleccionada" spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblNombrePaquete" text="Seleccione un paquete" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblPrecioPaquete" text=" &#36;0.00" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #1a82b8;"/>
                    </HBox>
                    <Label fx:id="lblDetallesPaquete" text="Los detalles aparecerán aquí" style="-fx-text-fill: #7f8c8d;"/>
                </VBox>
            </VBox>

            <!-- SERVICIOS EXTRAS -->
            <VBox styleClass="tarjeta-blanca" spacing="12" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="SERVICIOS EXTRAS" styleClass="titulo-seccion">
                        <graphic>
                            <SVGPath content="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="#2c3e50" scaleX="0.8" scaleY="0.8"/>
                        </graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Añadir Servicio" styleClass="boton-azul-claro" onAction="#abrirDialogoAgregarServicio"/>
                </HBox>

                <Label text="Mantén presionada la tecla Ctrl para seleccionar varios extras" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                <ListView fx:id="listaServiciosExtras" VBox.vgrow="ALWAYS" prefHeight="200" styleClass="lista-moderna" />
            </VBox>

            <!-- BOTONES DE ACCIÓN -->
            <HBox styleClass="tarjeta-blanca" alignment="CENTER_RIGHT" spacing="20">
                <Button text="Guardar Borrador" onAction="#guardarCotizacion"
                        style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button text="Confirmar Cotización" styleClass="boton-azul" onAction="#guardarCotizacion">
                    <graphic>
                        <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="WHITE"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>