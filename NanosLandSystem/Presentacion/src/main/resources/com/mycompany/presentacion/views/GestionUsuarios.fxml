<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.GestionUsuariosController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS" spacing="5">
            <Label text="Gestión de Usuarios del Sistema" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <graphic>
                    <javafx.scene.shape.SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#2c3e50" scaleX="1.2" scaleY="1.2"/>
                </graphic>
            </Label>
            <Label text="Administra las cuentas de acceso al sistema y sus roles." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
        <HBox spacing="10">
            <Button fx:id="btnEditar" text="Editar" styleClass="boton-azul-claro" disable="true" onAction="#editarUsuario"/>
            <Button fx:id="btnEliminar" text="Desactivar" styleClass="boton-rojo" disable="true" onAction="#eliminarUsuario"/>
            <Button text="+ Nuevo Usuario" styleClass="boton-azul" onAction="#nuevoUsuario"/>
        </HBox>
    </HBox>

    <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="20">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <javafx.scene.shape.SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#7f8c8d" />
            <TextField fx:id="txtBuscar" promptText="Buscar por correo o teléfono..." HBox.hgrow="ALWAYS" styleClass="text-field-moderno"/>
        </HBox>

        <fx:define>
            <TableView fx:id="tablaUsuarios">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCorreo" text="Correo Electrónico" prefWidth="250" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="150" style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </fx:define>

        <Pagination fx:id="paginacion" VBox.vgrow="ALWAYS" maxPageIndicatorCount="7" />
    </VBox>
</VBox>
