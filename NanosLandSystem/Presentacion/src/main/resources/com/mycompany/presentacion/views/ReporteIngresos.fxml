<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.ReporteIngresosController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Reporte de Ingresos (Flujo de Caja)" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Label text="Analiza el dinero real que ha ingresado al negocio (anticipos y liquidaciones)." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
    </HBox>

    <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="15">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Fecha Inicio" styleClass="label-pequeno"/>
                <DatePicker fx:id="dpInicio" styleClass="date-picker-moderno"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Fecha Fin" styleClass="label-pequeno"/>
                <DatePicker fx:id="dpFin" styleClass="date-picker-moderno"/>
            </VBox>
            
            <VBox alignment="BOTTOM_CENTER" spacing="5">
                <Button fx:id="btnGenerar" text="Generar Reporte" styleClass="boton-primario" onAction="#generarReporte">
                    <graphic><SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="white" scaleX="0.8" scaleY="0.8"/></graphic>
                </Button>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <VBox alignment="BOTTOM_CENTER" spacing="5">
                <Button fx:id="btnExportar" text="Exportar a PDF" disable="true" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" onAction="#exportarPDF">
                    <graphic><SVGPath content="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z" fill="white" scaleX="0.8" scaleY="0.8"/></graphic>
                </Button>
            </VBox>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Total Ingresado en el Periodo:" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                <Label fx:id="lblIngresoTotal" text="\$0.00" style="-fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-font-size: 18px;"/>
            </HBox>
        </HBox>

        <fx:define>
            <TableView fx:id="tablaIngresos" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colFecha" text="Fecha/Hora" prefWidth="130" />
                    <TableColumn fx:id="colFolioPago" text="Folio Pago" prefWidth="100" />
                    <TableColumn fx:id="colCotizacion" text="Cotización" prefWidth="100" />
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180" />
                    <TableColumn fx:id="colMetodo" text="Método" prefWidth="100" />
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="120" />
                </columns>
            </TableView>
        </fx:define>

        <Pagination fx:id="paginacion" VBox.vgrow="ALWAYS" maxPageIndicatorCount="7" />
    </VBox>
</VBox>
