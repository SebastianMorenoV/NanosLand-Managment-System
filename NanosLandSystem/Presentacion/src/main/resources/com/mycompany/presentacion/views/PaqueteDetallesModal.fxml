<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="20" stylesheets="@../styles/styles.css" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.PaqueteDetallesModalController">
    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <!-- Información Básica del Paquete -->
    <VBox spacing="10" styleClass="tarjeta-blanca">
        <Label text="Detalles del Paquete" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <graphic><SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" fill="#2c3e50" scaleX="1.2" scaleY="1.2"/></graphic>
        </Label>
        
        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="NOMBRE DEL PAQUETE" styleClass="label-pequeno"/>
                <Label fx:id="lblNombre" text="-" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a82b8;"/>
            </VBox>
            <VBox spacing="5" alignment="CENTER_RIGHT">
                <Label text="COSTO BASE" styleClass="label-pequeno"/>
                <Label fx:id="lblCostoBase" text="0.00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            </VBox>
        </HBox>
        <VBox spacing="5">
            <Label text="DESCRIPCIÓN" styleClass="label-pequeno"/>
            <Label fx:id="lblDescripcion" text="-" wrapText="true" style="-fx-text-fill: #7f8c8d;"/>
        </VBox>
    </VBox>

    <!-- Gestión de Servicios -->
    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <Label text="SERVICIOS INCLUIDOS" styleClass="titulo-seccion"/>
        <!-- Tabla de Servicios -->
        <TableView fx:id="tablaServicios" VBox.vgrow="ALWAYS" prefHeight="200">
            <columns>
                <TableColumn fx:id="colServicioNombre" text="Servicio" prefWidth="250" />
                <TableColumn fx:id="colPrecioUnitario" text="Precio Unit." prefWidth="100" />
                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80" />
                <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="100" />
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER" spacing="15">
        <Button text="Cerrar Detalles" styleClass="boton-azul" onAction="#cerrarModal"/>
    </HBox>
</VBox>
