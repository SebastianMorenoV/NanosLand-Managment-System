<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" stylesheets="@../styles/styles.css" styleClass="modal-fondo" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.ConfirmarPagoModalController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Confirmar Pago" style="-fx-font-size: 1.5em; -fx-font-weight: bold; -fx-text-fill: #1a82b8;"/>
    <Separator/>

    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5;">
        <Label text="Resumen de Cotización" style="-fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
        <HBox spacing="10">
            <Label text="Subtotal:" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="lblSubtotal" text="\$0.00"/>
        </HBox>
        <HBox spacing="10">
            <Label text="Cargos Extra:" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="lblCargosExtra" text="\$0.00"/>
        </HBox>
        <Separator/>
        <HBox spacing="10">
            <Label text="Total a Pagar:" style="-fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="lblTotal" text="\$0.00" style="-fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <VBox spacing="5">
        <Label text="Monto del Anticipo"/>
        <TextField fx:id="txtAnticipo" promptText="\$0.00" styleClass="text-field-moderno"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Método de Pago"/>
        <ComboBox fx:id="comboMetodoPago" maxWidth="Infinity" promptText="Seleccione método..." styleClass="combo-box-moderno"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar" styleClass="boton-secundario"/>
        <Button fx:id="btnConfirmar" text="Confirmar Pago" onAction="#confirmar" styleClass="boton-primario"/>
    </HBox>
</VBox>