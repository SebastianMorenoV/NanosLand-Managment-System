<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.UsuariosController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Gestión de Clientes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Administra el directorio de clientes registrados en el sistema." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
        <Button text="+ Nuevo Cliente" styleClass="boton-azul"/>
    </HBox>

    <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="15">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField promptText="Buscar por nombre, teléfono o correo..." HBox.hgrow="ALWAYS" styleClass="text-field-moderno"/>
            <Button text="Buscar" styleClass="boton-azul-claro"/>
        </HBox>

        <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #ccd4db; -fx-border-radius: 5px;">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="ID" prefWidth="50" maxWidth="80" />
                <TableColumn text="Nombre Completo" prefWidth="250" />
                <TableColumn text="Teléfono" prefWidth="150" />
                <TableColumn text="Correo Electrónico" prefWidth="200" />
                <TableColumn text="Último Evento" prefWidth="150" />
            </columns>
        </TableView>
    </VBox>
</VBox>