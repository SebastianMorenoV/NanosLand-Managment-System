<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.UsuariosController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS" spacing="5">
            <Label text="Gestión de Clientes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <graphic>
                    <javafx.scene.shape.SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#2c3e50" scaleX="1.2" scaleY="1.2"/>
                </graphic>
            </Label>
            <Label text="Administra el directorio de clientes registrados en el sistema." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
        <HBox spacing="10">
            <Button fx:id="btnEditar" text="Editar" styleClass="boton-azul-claro" disable="true" onAction="#editarCliente"/>
            <Button fx:id="btnEliminar" text="Eliminar" styleClass="boton-rojo" disable="true" onAction="#eliminarCliente"/>
            <Button text="+ Nuevo Cliente" styleClass="boton-azul" onAction="#nuevoCliente"/>
        </HBox>
    </HBox>

    <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="20">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <javafx.scene.shape.SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#7f8c8d" />
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre, teléfono o correo..." HBox.hgrow="ALWAYS" styleClass="text-field-moderno"/>
        </HBox>

        <fx:define>
            <TableView fx:id="tablaUsuarios">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="80" />
                    <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="250" />
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120" />
                    <TableColumn fx:id="colCorreo" text="Correo Electrónico" prefWidth="180" />
                    <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="120" />
                    <TableColumn fx:id="colColonia" text="Colonia" prefWidth="150" />
                </columns>
            </TableView>
        </fx:define>
        
        <Pagination fx:id="paginacion" VBox.vgrow="ALWAYS" maxPageIndicatorCount="7" />
    </VBox>
</VBox>