<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.ReporteOportunidadesController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Oportunidades de Venta (Re-compra)" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
            <Label text="Busca a los clientes del año pasado para ofrecerles tu servicio en su próximo festejo." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
    </HBox>

    <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="15">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Mes del Evento Pasado" styleClass="label-pequeno"/>
                <ComboBox fx:id="cmbMes" prefWidth="120" styleClass="combo-box-moderno"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Año" styleClass="label-pequeno"/>
                <ComboBox fx:id="cmbAnio" prefWidth="120" styleClass="combo-box-moderno"/>
            </VBox>
            
            <VBox alignment="BOTTOM_CENTER" spacing="5">
                <Button fx:id="btnGenerar" text="Buscar Leads" styleClass="boton-primario" onAction="#generarReporte">
                    <graphic><SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="white" scaleX="0.8" scaleY="0.8"/></graphic>
                </Button>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <VBox alignment="BOTTOM_CENTER" spacing="5">
                <Button fx:id="btnExportar" text="Exportar Leads PDF" disable="true" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" onAction="#exportarPDF">
                    <graphic><SVGPath content="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z" fill="white" scaleX="0.8" scaleY="0.8"/></graphic>
                </Button>
            </VBox>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Contactos Encontrados:" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                <Label fx:id="lblCantidadLeads" text="0" style="-fx-font-weight: bold; -fx-text-fill: #f39c12; -fx-font-size: 16px;"/>
            </HBox>
        </HBox>

        <fx:define>
            <TableView fx:id="tablaOportunidades" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCliente" text="Nombre Cliente" prefWidth="200" />
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120" />
                    <TableColumn fx:id="colFechaPasada" text="Fecha Evento Anterior" prefWidth="140" />
                    <TableColumn fx:id="colPaquete" text="Paquete que contrató" prefWidth="180" />
                    <TableColumn fx:id="colGasto" text="Gasto Aprox." prefWidth="120" />
                </columns>
            </TableView>
        </fx:define>

        <Pagination fx:id="paginacion" VBox.vgrow="ALWAYS" maxPageIndicatorCount="7" />
    </VBox>
</VBox>
