<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<HBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.EstadoCuentaController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <!-- Panel Izquierdo: Lista de Eventos -->
    <VBox prefWidth="300" spacing="15">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Estado de Cuenta" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <graphic>
                    <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="#2c3e50" scaleX="1.0" scaleY="1.0"/>
                </graphic>
            </Label>
        </HBox>
        <TextField fx:id="txtBuscar" promptText="Buscar por folio o cliente..." styleClass="text-field-moderno"/>
        
        <VBox styleClass="panel-cotizaciones" VBox.vgrow="ALWAYS">
            <ListView fx:id="listaEventos" VBox.vgrow="ALWAYS"/>
        </VBox>
    </VBox>

    <!-- Panel Derecho: Desglose Financiero -->
    <VBox fx:id="panelDetalle" HBox.hgrow="ALWAYS" spacing="15" visible="false">
        <Label text="Desglose Financiero del Evento" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        
        <!-- Resumen Cabecera -->
        <HBox styleClass="tarjeta-blanca" spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="lblFolio" text="Folio: " style="-fx-font-weight: bold; -fx-text-fill: #1a82b8;"/>
                <Label fx:id="lblCliente" text="Cliente: "/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="lblFecha" text="Fecha: "/>
                <Label fx:id="lblEstado" text="Estado: " style="-fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <HBox spacing="15" VBox.vgrow="ALWAYS">
            <!-- Columna de Cargos -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="300">
                <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="5">
                    <Label text="PRESUPUESTO ORIGINAL" styleClass="titulo-seccion"/>
                    <ListView fx:id="listaPresupuesto" VBox.vgrow="ALWAYS" prefHeight="100"/>
                </VBox>
                <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="CARGOS EXTRAS" styleClass="titulo-seccion"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Cargo" styleClass="boton-azul-claro" onAction="#abrirModalCargoExtra" style="-fx-font-size: 10px; -fx-padding: 3 8 3 8;"/>
                    </HBox>
                    <ListView fx:id="listaCargos" VBox.vgrow="ALWAYS" prefHeight="100"/>
                </VBox>
            </VBox>
            
            <!-- Columna de Pagos y Totales -->
            <VBox spacing="10" prefWidth="250">
                <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="5">
                    <Label text="PAGOS REALIZADOS" styleClass="titulo-seccion"/>
                    <ListView fx:id="listaPagos" VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- Totales Consolidados -->
                <VBox styleClass="tarjeta-blanca" spacing="10">
                    <Label text="BALANCE GENERAL" styleClass="titulo-seccion"/>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Gran Total:" style="-fx-text-fill: #7f8c8d;"/>
                        <Label fx:id="lblGranTotal" text="$0.00" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="Pagado:" style="-fx-text-fill: #27ae60;"/>
                        <Label fx:id="lblPagado" text="$0.00" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </HBox>
                    <Separator/>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="SALDO PENDIENTE:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblSaldoPendiente" text="$0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</HBox>
