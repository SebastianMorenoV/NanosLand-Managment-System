<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="rootPane" stylesheets="@../styles/styles.css" styleClass="raiz-fondo" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.MainShellController">
    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="10">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <HBox alignment="CENTER">
                <ImageView fx:id="imgLogo" fitWidth="120" preserveRatio="true"/>
            </HBox>
            <Separator />
            <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" styleClass="scroll-pane" VBox.vgrow="ALWAYS" minHeight="0">
                <VBox spacing="10" minHeight="0">
                    <ToggleButton fx:id="btnCotizacion" text="Nueva Cotización" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navCotizacion">
                        <graphic><SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnEventos" text="Eventos" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navEventos">
                        <graphic><SVGPath content="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zm-7 5h5v5h-5z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnClientes" text="Clientes" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navClientes">
                        <graphic><SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnPaquetes" text="Paquetes" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navPaquetes">
                        <graphic><SVGPath content="M21 16.5c0 .38-.21.71-.53.88l-7.9 4.44c-.16.12-.36.18-.57.18-.21 0-.41-.06-.57-.18l-7.9-4.44A.991.991 0 0 1 3 16.5v-9c0-.38.21-.71.53-.88l7.9-4.44c.16-.12.36-.18.57-.18.21 0 .41.06.57.18l7.9 4.44c.32.17.53.5.53.88v9zM12 4.15L6.04 7.5 12 10.85l5.96-3.35L12 4.15zM5 15.91l6 3.38v-6.71L5 9.21v6.7zM19 15.91v-6.7l-6 3.37v6.71l6-3.38z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnLogistica" text="Logística" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navLogistica">
                        <graphic><SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnEstadoCuenta" text="Estado de Cuenta" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navEstadoCuenta">
                        <graphic><SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnReportes" text="Reporte Eventos" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navReportes">
                        <graphic><SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnReporteAdeudos" text="Reporte Adeudos" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navReporteAdeudos">
                        <graphic><SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="#e74c3c" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnReporteIngresos" text="Reporte Ingresos" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navReporteIngresos">
                        <graphic><SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="#27ae60" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnOportunidades" text="Oportunidades" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navOportunidades">
                        <graphic><SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#f39c12" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnGestionUsuarios" text="Gestión Usuarios" styleClass="boton-menu" prefWidth="210" toggleGroup="$navGroup" onAction="#navGestionUsuarios" visible="false" managed="false">
                        <graphic><SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#1a82b8" scaleX="0.8" scaleY="0.8"/></graphic>
                    </ToggleButton>
                </VBox>
            </ScrollPane>
            
            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>
            <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                <Label fx:id="lblUsuarioActual" text="" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 11px;" wrapText="true"/>
                <Label text="📍 Sucursal Principal" style="-fx-font-weight: bold; -fx-text-fill: #1a82b8; -fx-font-size: 13px;"/>
                <Label fx:id="lblReloj" text="Cargando..." style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                <Label text="F11: Pantalla completa" style="-fx-text-fill: #b2b2b2; -fx-font-size: 10px;"/>
            </VBox>
            <Button fx:id="btnCerrarSesion" text="Cerrar Sesión" styleClass="boton-texto-rojo" prefWidth="210" onAction="#cerrarSesion"/>
        </VBox>
    </left>
</BorderPane>
