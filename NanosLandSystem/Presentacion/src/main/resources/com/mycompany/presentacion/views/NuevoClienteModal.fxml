<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" stylesheets="@../styles/styles.css" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.NuevoClienteModalController">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <VBox spacing="5">
        <Label text="✨ Registrar Nuevo Cliente" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="Ingrese los datos de contacto." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
    </VBox>

    <VBox spacing="15">
        <VBox spacing="5">
            <Label text="NOMBRE COMPLETO" styleClass="label-pequeno"/>
            <TextField fx:id="txtNombre" promptText="Ej. Juan Pérez Gómez" styleClass="text-field-moderno"/>
        </VBox>

        <VBox spacing="5">
            <Label text="TELÉFONO" styleClass="label-pequeno"/>
            <TextField fx:id="txtTelefono" promptText="Ej. 6441234567" styleClass="text-field-moderno"/>
        </VBox>

        <VBox spacing="5">
            <Label text="CORREO ELECTRÓNICO (Opcional)" styleClass="label-pequeno"/>
            <TextField fx:id="txtCorreo" promptText="Ej. cliente@correo.com" styleClass="text-field-moderno"/>
        </VBox>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 10 0 0 0;">
        <Button text="Cancelar" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand;" onAction="#cerrarModal"/>
        <Button text="✔️ Guardar Cliente" styleClass="boton-azul" onAction="#guardarCliente"/>
    </HBox>
</VBox>