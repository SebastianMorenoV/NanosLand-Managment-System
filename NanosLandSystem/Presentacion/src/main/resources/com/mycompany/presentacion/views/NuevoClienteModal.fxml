<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="20" stylesheets="@../styles/styles.css" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.NuevoClienteModalController">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <VBox spacing="5">
        <Label text="Registrar Nuevo Cliente" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <graphic><SVGPath content="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#2c3e50" scaleX="1.2" scaleY="1.2"/></graphic>
        </Label>
        <Label text="Ingrese los datos de contacto." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
    </VBox>

    <HBox spacing="30">
        <!-- Columna Izquierda: Contacto -->
        <VBox spacing="15" prefWidth="280">
            <Label text="DATOS DE CONTACTO" styleClass="titulo-seccion"/>
            <VBox spacing="5">
                <Label text="NOMBRE COMPLETO" styleClass="label-pequeno"/>
                <TextField fx:id="txtNombre" promptText="Ej. Juan Pérez Gómez" styleClass="text-field-moderno"/>
            </VBox>

            <VBox spacing="5">
                <Label text="TELÉFONO" styleClass="label-pequeno"/>
                <TextField fx:id="txtTelefono" promptText="Ej. 6441234567" styleClass="text-field-moderno"/>
            </VBox>

            <VBox spacing="5">
                <Label text="CORREO ELECTRÓNICO (Opcional)" styleClass="label-pequeno"/>
                <TextField fx:id="txtCorreo" promptText="Ej. cliente@correo.com" styleClass="text-field-moderno"/>
            </VBox>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <!-- Columna Derecha: Dirección -->
        <VBox spacing="15" prefWidth="280">
            <Label text="DIRECCIÓN (Opcional)" styleClass="titulo-seccion"/>
            <VBox spacing="5">
                <Label text="CALLE Y NÚMERO" styleClass="label-pequeno"/>
                <TextField fx:id="txtCalle" promptText="Ej. Av. Principal 123" styleClass="text-field-moderno"/>
            </VBox>

            <VBox spacing="5">
                <Label text="COLONIA" styleClass="label-pequeno"/>
                <TextField fx:id="txtColonia" promptText="Ej. Centro" styleClass="text-field-moderno"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="CIUDAD" styleClass="label-pequeno"/>
                    <TextField fx:id="txtCiudad" promptText="Ej. Cajeme" styleClass="text-field-moderno"/>
                </VBox>
                <VBox spacing="5" prefWidth="100">
                    <Label text="C.P." styleClass="label-pequeno"/>
                    <TextField fx:id="txtCodigoPostal" promptText="85000" styleClass="text-field-moderno"/>
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 10 0 0 0;">
        <Button text="Cancelar" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand;" onAction="#cerrarModal"/>
        <Button text="Guardar Cliente" styleClass="boton-azul" onAction="#guardarCliente">
            <graphic><SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="WHITE"/></graphic>
        </Button>
    </HBox>
</VBox>