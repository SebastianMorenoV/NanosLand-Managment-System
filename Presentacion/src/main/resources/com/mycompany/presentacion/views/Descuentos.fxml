<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.DescuentosController">
    <padding><Insets top="28" right="36" bottom="24" left="36"/></padding>

    <fx:define>
        <ToggleGroup fx:id="grupoFiltro"/>
    </fx:define>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox HBox.hgrow="ALWAYS" spacing="2">
            <Label text="Descuentos" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Rebajas que se aplican solas al precio de los paquetes, según el día o la temporada del evento." wrapText="true" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
        <Button text="+ Nuevo descuento" minWidth="-Infinity" styleClass="boton-azul" onAction="#nuevo"/>
    </HBox>

    <VBox styleClass="tarjeta-blanca" VBox.vgrow="ALWAYS" spacing="14">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ToggleButton fx:id="btnActivos" text="Activos" minWidth="-Infinity" styleClass="pestana" toggleGroup="$grupoFiltro"/>
            <ToggleButton fx:id="btnPausados" text="Pausados" minWidth="-Infinity" styleClass="pestana" toggleGroup="$grupoFiltro"/>
            <ToggleButton fx:id="btnVencidos" text="Vencidos" minWidth="-Infinity" styleClass="pestana" toggleGroup="$grupoFiltro"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre o paquete..." prefWidth="280" styleClass="text-field-moderno"/>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <VBox fx:id="listaDescuentos" spacing="10" styleClass="fondo-blanco"/>
        </ScrollPane>

        <Label text="Si a una cotización le tocan varios descuentos, se aplica solo el que más rebaja. Las cotizaciones ya guardadas conservan su precio aunque el descuento cambie o se borre."
               wrapText="true" styleClass="texto-ayuda"/>
    </VBox>
</VBox>
