<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="16" prefWidth="620" stylesheets="@../styles/styles.css" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.DescuentoModalController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <VBox spacing="4">
        <Label fx:id="lblTitulo" text="Nuevo descuento" styleClass="titulo-modal"/>
        <Label text="Se resta del precio del paquete según la fecha del evento. Los servicios extra no llevan descuento." wrapText="true" styleClass="subtitulo-modal"/>
    </VBox>

    <HBox spacing="15" alignment="BOTTOM_LEFT">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Nombre" styleClass="label-pequeno"/>
            <TextField fx:id="txtNombre" promptText="Ej: Entre semana, Diciembre 2026" styleClass="text-field-moderno"/>
        </VBox>
        <CheckBox fx:id="chkActivo" text="Activo" selected="true" style="-fx-padding: 0 0 8 0;"/>
    </HBox>

    <HBox spacing="15" alignment="BOTTOM_LEFT">
        <VBox spacing="8">
            <Label text="Tipo de descuento" styleClass="label-pequeno"/>
            <HBox spacing="18" style="-fx-padding: 0 0 8 0;">
                <RadioButton fx:id="rbPorcentaje" text="Porcentaje (%)" selected="true"/>
                <RadioButton fx:id="rbMontoFijo" text="Monto fijo ($)"/>
            </HBox>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label fx:id="lblValor" text="Porcentaje" styleClass="label-pequeno"/>
            <TextField fx:id="txtValor" promptText="Ej: 15" styleClass="text-field-moderno"/>
        </VBox>
    </HBox>

    <VBox spacing="8">
        <Label text="Paquetes" styleClass="label-pequeno"/>
        <HBox spacing="18">
            <RadioButton fx:id="rbTodosPaquetes" text="Todos los paquetes" selected="true"/>
            <RadioButton fx:id="rbAlgunosPaquetes" text="Solo los que elija"/>
        </HBox>
        <!-- Sin ScrollPane: su fondo transparente vuelve blanco el texto de las casillas. -->
        <FlowPane fx:id="boxPaquetes" hgap="18" vgap="8" prefWrapLength="520"
                  style="-fx-background-color: #f8f9fa; -fx-background-radius: 6; -fx-border-color: #dadddf; -fx-border-radius: 6; -fx-padding: 10;"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Días del evento" styleClass="label-pequeno"/>
        <HBox fx:id="boxDias" spacing="14" alignment="CENTER_LEFT"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Elegir:" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Button text="Todos" styleClass="boton-texto-gris" style="-fx-font-size: 12px; -fx-padding: 2 6;" onAction="#diasTodos"/>
            <Button text="Lunes a jueves" styleClass="boton-texto-gris" style="-fx-font-size: 12px; -fx-padding: 2 6;" onAction="#diasEntreSemana"/>
            <Button text="Viernes a domingo" styleClass="boton-texto-gris" style="-fx-font-size: 12px; -fx-padding: 2 6;" onAction="#diasFinDeSemana"/>
        </HBox>
    </VBox>

    <HBox spacing="15">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Temporada (fechas del evento)" styleClass="label-pequeno"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <DatePicker fx:id="dpInicio" promptText="Desde" prefWidth="140" styleClass="text-field-moderno"/>
                <Label text="a" style="-fx-text-fill: #7f8c8d;"/>
                <DatePicker fx:id="dpFin" promptText="Hasta" prefWidth="140" styleClass="text-field-moderno"/>
            </HBox>
            <Label text="Vacías: aplica en cualquier fecha." style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Se puede cotizar hasta" styleClass="label-pequeno"/>
            <DatePicker fx:id="dpCotizarHasta" promptText="Sin límite" prefWidth="150" styleClass="text-field-moderno"/>
            <Label text="Último día para cotizar con este precio." style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </VBox>
    </HBox>

    <Label fx:id="lblResumen" wrapText="true" maxWidth="Infinity" minHeight="-Infinity" styleClass="resumen-cobro" style="-fx-text-fill: #2c3e50;"/>

    <HBox alignment="CENTER_RIGHT" spacing="15">
        <Button text="Cancelar" styleClass="boton-texto-gris" onAction="#cerrarModal"/>
        <Button text="Guardar descuento" styleClass="boton-azul" onAction="#guardar"/>
    </HBox>
</VBox>
