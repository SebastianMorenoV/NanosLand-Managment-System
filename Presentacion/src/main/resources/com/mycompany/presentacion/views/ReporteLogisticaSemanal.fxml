<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="14" prefWidth="820" prefHeight="680" stylesheets="@../styles/styles.css" styleClass="raiz-fondo"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.presentacion.controllers.ReporteLogisticaSemanalController">
    <padding><Insets top="22" right="26" bottom="18" left="26"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Logística de la semana" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnExportar" text="Guardar PDF" minWidth="-Infinity" styleClass="boton-verde" onAction="#exportarPDF"/>
        <Button text="Cerrar" minWidth="-Infinity" styleClass="boton-texto-gris" onAction="#cerrar"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10" styleClass="tarjeta-blanca">
        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
        <Button text="← Anterior" minWidth="-Infinity" styleClass="boton-azul-claro" onAction="#semanaAnterior"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER" spacing="2" minWidth="-Infinity">
            <Label fx:id="lblSemana" minWidth="-Infinity" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Button fx:id="btnEstaSemana" text="Volver a esta semana" minWidth="-Infinity" styleClass="boton-texto-gris" onAction="#semanaActual" style="-fx-font-size: 11px; -fx-padding: 2 8 2 8;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Siguiente →" minWidth="-Infinity" styleClass="boton-azul-claro" onAction="#semanaSiguiente"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane" hbarPolicy="NEVER">
        <VBox fx:id="contenido" spacing="10">
            <padding><Insets top="2" right="12" bottom="8" left="2"/></padding>
        </VBox>
    </ScrollPane>
</VBox>
