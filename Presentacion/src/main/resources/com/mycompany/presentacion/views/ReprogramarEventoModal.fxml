<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" prefWidth="420" stylesheets="@../styles/styles.css" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.ReprogramarEventoModalController">
    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <!-- Cabecera -->
    <VBox spacing="4">
        <Label text="Reprogramar Evento" styleClass="titulo-modal"/>
        <Label text="Seleccione la nueva fecha, el turno y el horario del evento." styleClass="subtitulo-modal"/>
    </VBox>

    <!-- Formulario -->
    <VBox spacing="5">
        <Label text="NUEVA FECHA *" styleClass="label-pequeno"/>
        <DatePicker fx:id="dpNuevaFecha" promptText="Seleccionar fecha" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5">
        <Label text="NUEVO TURNO *" styleClass="label-pequeno"/>
        <ComboBox fx:id="cmbNuevoTurno" promptText="Seleccionar turno" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="HORA DE INICIO *" styleClass="label-pequeno"/>
            <ComboBox fx:id="cmbHoraInicio" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="HORA DE FIN *" styleClass="label-pequeno"/>
            <ComboBox fx:id="cmbHoraFin" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <!-- Acciones -->
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Cancelar" styleClass="boton-texto-gris" onAction="#cerrarModal"/>
        <Button text="Guardar Cambios" styleClass="boton-azul" onAction="#guardarReprogramacion"/>
    </HBox>
</VBox>
