<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<HBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.presentacion.controllers.VentasController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <fx:define>
        <ToggleGroup fx:id="grupoPago"/>
    </fx:define>

    <!-- Izquierda: productos y ventas del día -->
    <VBox HBox.hgrow="ALWAYS" spacing="15" minWidth="420">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Ventas" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Cosas que se venden aparte de los eventos." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
            </VBox>
            <Button fx:id="btnProductos" text="Administrar productos" minWidth="-Infinity" styleClass="boton-azul-claro" onAction="#abrirProductos"/>
        </HBox>

        <VBox styleClass="tarjeta-blanca" spacing="10" prefHeight="250" minHeight="150">
            <Label text="Toca lo que se vende" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblSinProductos" text="Todavía no hay productos. Agrégalos con el botón Administrar productos." wrapText="true" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <FlowPane fx:id="panelProductos" hgap="10" vgap="10"/>
            </ScrollPane>
        </VBox>

        <VBox styleClass="tarjeta-blanca" spacing="10" VBox.vgrow="ALWAYS" minHeight="180">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblTituloVentas" text="Ventas de hoy" minWidth="-Infinity" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotalDia" minWidth="-Infinity" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                <DatePicker fx:id="dpDia" prefWidth="140" minWidth="-Infinity" styleClass="date-picker"/>
            </HBox>
            <Label fx:id="lblSinVentas" text="No hay ventas." style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox fx:id="listaVentas" spacing="6"/>
            </ScrollPane>
        </VBox>
    </VBox>

    <!-- Derecha: la venta en curso -->
    <VBox styleClass="tarjeta-blanca" spacing="12" prefWidth="370" minWidth="340" maxWidth="400">
        <Label text="Esta venta" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label fx:id="lblCarritoVacio" text="Toca un producto para agregarlo." wrapText="true" style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox fx:id="listaCarrito" spacing="8"/>
        </ScrollPane>

        <Separator/>
        <Label text="¿Cómo pagó?" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <HBox spacing="6">
            <ToggleButton fx:id="btnEfectivo" text="Efectivo" toggleGroup="$grupoPago" maxWidth="Infinity" minWidth="-Infinity" HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="btnTransferencia" text="Transferencia" toggleGroup="$grupoPago" maxWidth="Infinity" minWidth="-Infinity" HBox.hgrow="ALWAYS"/>
            <ToggleButton fx:id="btnTarjeta" text="Tarjeta" toggleGroup="$grupoPago" maxWidth="Infinity" minWidth="-Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Label text="Total" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </HBox>

        <Label fx:id="lblMensaje" wrapText="true" visible="false" managed="false" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        <Button fx:id="btnRegistrar" text="Registrar venta" styleClass="boton-verde" maxWidth="Infinity" onAction="#registrarVenta" style="-fx-font-size: 16px; -fx-padding: 12 0 12 0;"/>
        <Button fx:id="btnVaciar" text="Empezar de nuevo" styleClass="boton-texto-gris" maxWidth="Infinity" onAction="#vaciarVenta"/>
    </VBox>
</HBox>
